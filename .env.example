# 정규화기 설정 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# .env 는 .gitignore 에 있어 저장소에 올라가지 않습니다.

# Anthropic API 키. 비워두면 규칙 파서만 사용합니다.
ANTHROPIC_API_KEY=

# auto : 키가 있으면 LLM 정규화, 실패하면 규칙 파서로 되돌아감 (기본값)
# llm  : LLM 정규화만 사용. 실패하면 오류를 반환
# rules: 규칙 파서만 사용 (외부 호출 없음)
NORMALIZER=auto

NORMALIZER_MODEL=claude-sonnet-5
NORMALIZER_TIMEOUT=60
